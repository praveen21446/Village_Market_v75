# Village Market v68 - PostgreSQL production configuration

# Application
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256

# PostgreSQL (required for production)
# Local PostgreSQL example:
DATABASE_URL=postgresql+psycopg://village_market:CHANGE_ME@127.0.0.1:5432/village_market
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Primary admin
ADMIN_ID=admin
ADMIN_PASSWORD=looser@123

# Local or cloud object storage
STORAGE_BACKEND=local
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# Optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@villagemarket.local
SMTP_TLS=1

# Optional Twilio SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional Razorpay configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
