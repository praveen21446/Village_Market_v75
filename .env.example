# Village Market production environment template
# Copy variable NAMES only. Store real secrets in Railway Variables, never in GitHub.

APP_ENV=production
SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
ALGORITHM=HS256

# PostgreSQL - use Railway's Postgres DATABASE_URL reference in production.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Primary admin - REQUIRED in production. Use a strong unique password.
ADMIN_ID=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD

# Upload/storage security
STORAGE_BACKEND=local
MAX_UPLOAD_MB=5
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# Optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# Optional Twilio notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# MSG91 real OTP
# MSG91_AUTH_KEY is a backend secret and must only be stored in Railway Variables.
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=

# Maximum number of photos allowed per crop listing
MAX_CROP_PHOTOS=8
